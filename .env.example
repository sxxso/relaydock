# 必填其中一项。推荐 npm run setup 生成 .env.local 中的哈希。
RELAYDOCK_ADMIN_PASSWORD=
# RELAYDOCK_ADMIN_PASSWORD_HASH=scrypt:...
# 远程 HTTPS 部署必填，不能留成 localhost。
# RELAYDOCK_PUBLIC_URL=https://atlas.example.com
# 默认 ./data；生产容器为 /app/data。
# RELAYDOCK_DATA_DIR=./data
# 仅在确需访问自托管私有站点时配置精确主机名（不接受通配符）。
# RELAYDOCK_PRIVATE_HOSTS=relay.internal.example
# DNS 默认为系统解析。系统 DNS 异常时可显式选择 cloudflare（DNS-over-HTTPS）。
# 仅点击查询时发送域名给解析器，不发送站点密钥。不自动降级或重试。
# 仍验证解析器和目标全部 IP，固定连接地址，拒绝私有/元数据及重定向。
# RELAYDOCK_DNS_MODE=system
# RELAYDOCK_DNS_MODE=cloudflare
# 不会自动使用 Windows 代理；DNS-over-HTTPS 本身也需部署网络可达。
# 可选查询代理，默认关闭；只读取此显式变量，不读取系统/HTTP_PROXY/HTTPS_PROXY。
# 初次配置/改地址需重启；随后可在刷新旁/设置页即时切换直连与代理，选择保存在本部署。
# 切换本身不查询；已选代理但配置失效会拒绝查询，不自动回退直连。
# 只支持 HTTP/HTTPS CONNECT（HTTP 和 HTTPS 目标均需 CONNECT），不支持 SOCKS。
# 代理是部署信任边界：可显式配置本机/私有地址，但元数据、未指定及组播地址始终拒绝。
# 目标仍先本地解析并验证，CONNECT 固定目标 IP；代理自身也解析、验证并固定连接 IP。
# RELAYDOCK_QUERY_PROXY_URL=http://proxy.internal.example:8080
# 可选 Basic 认证，用户名/密码需 URL 编码；HTTP 代理会明文传输代理认证，请优先 HTTPS。
# RELAYDOCK_QUERY_PROXY_URL=https://proxy-user:URL_ENCODED_PASSWORD@proxy.internal.example:8443
# 不自动启用 DoH；DoH 独立配置且不走查询代理。不重试、不跟随重定向、不回退直连。
# 可选 64 位十六进制主密钥；未配置则自动持久化到 data/vault.key。
# RELAYDOCK_VAULT_KEY=
NEXT_TELEMETRY_DISABLED=1
